# Django

# Generate your own before deploying anywhere public, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-prod

# Comma-separated list of hosts Django will answer for. Any other host gets a
# 400. Ignored by the dev stack, which runs with debug on and accepts anything.
DJANGO_ALLOWED_HOSTS=yourdomain.com


# Routing

# The host the app is served on. Used by the Traefik router rule in
# docker-compose.yml, so it is needed whenever those labels are read —
# whether Traefik comes from this stack or already runs on the host.
DOMAIN=yourdomain.com

# Requests per second per client, and how far a burst may exceed that.
# Same story: set on the app's labels in docker-compose.yml.
RATE_LIMIT_AVERAGE=10
RATE_LIMIT_BURST=20

# Contact address for Let's Encrypt expiry notices. Only read by
# docker-compose.traefik.yml, i.e. when the stack brings its own Traefik.
ACME_EMAIL=you@example.com


# Local

# Host port the app is published on, bound to 127.0.0.1 in every stack — a
# reverse proxy running on the host reaches it there. Nothing is exposed to the
# outside world; that is the proxy's job.
APP_PORT=8000
